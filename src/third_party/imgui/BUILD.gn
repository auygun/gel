config("imgui_freetype_config") {
  defines = [
    "IMGUI_ENABLE_FREETYPE",

    # Make ImWchar 32-bit. Without this ImGui replaces every codepoint above
    # U+FFFF with IM_UNICODE_CODEPOINT_INVALID, so emoji render as "?".
    "IMGUI_USE_WCHAR32",
  ]
}

source_set("imgui") {
  configs -= [ "//src/third_party/kaliber/build:warnings" ]

  public_configs = [ ":imgui_freetype_config" ]

  include_dirs = [ "imgui" ]

  sources = [
    "imgui/imconfig.h",
    "imgui/imgui.cpp",
    "imgui/imgui.h",
    "imgui/imgui_demo.cpp",
    "imgui/imgui_draw.cpp",
    "imgui/imgui_internal.h",
    "imgui/imgui_tables.cpp",
    "imgui/imgui_widgets.cpp",
    "imgui/imstb_rectpack.h",
    "imgui/imstb_textedit.h",
    "imgui/imstb_truetype.h",
    "imgui/misc/freetype/imgui_freetype.cpp",
    "imgui/misc/freetype/imgui_freetype.h",
  ]

  deps = [ "//src/third_party/freetype" ]
}
