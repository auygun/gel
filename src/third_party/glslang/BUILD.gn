config("glslang_public") {
  include_dirs = [ "glslang" ]

  cflags = []

  if (target_os == "win") {
    cflags += [
      "/wd4464",  # relative include path contains '..'
      "/wd4458",  # declaration hides class member
    ]
  } else {
    cflags += [ "-fno-finite-math-only" ]
  }
}

config("glslang_warnings") {
  cflags = []

  if (!is_win) {
    if (!is_clang) {
      cflags += [ "-Wno-stringop-overread" ]
    } else {
      cflags += [ "-Wno-deprecated-enum-enum-conversion" ]
    }
  }
}

action("glslang_build_info") {
  script = "glslang/build_info.py"

  src_dir = "glslang"
  changes_file = "glslang/CHANGES.md"
  template_file = "glslang/build_info.h.tmpl"
  out_file = "${target_gen_dir}/include/glslang/build_info.h"

  inputs = [
    changes_file,
    "glslang/build_info.py",
    template_file,
  ]
  outputs = [ out_file ]
  args = [
    rebase_path(src_dir, root_build_dir),
    "-i",
    rebase_path(template_file, root_build_dir),
    "-o",
    rebase_path(out_file, root_build_dir),
  ]
}

