action("help_data") {
  script = "//build/gen_help_data.py"
  sources = [ "//HELP.md" ]
  outputs = [ "$target_gen_dir/help_data.h" ]
  args = [
    rebase_path("//HELP.md", root_build_dir),
    rebase_path("$target_gen_dir/help_data.h", root_build_dir),
  ]
  public_configs = [ ":gen_data_include" ]
}

action("licenses_data") {
  script = "//build/gen_help_data.py"
  sources = [ "//LICENSE.md" ]
  outputs = [ "$target_gen_dir/licenses_data.h" ]
  args = [
    rebase_path("//LICENSE.md", root_build_dir),
    rebase_path("$target_gen_dir/licenses_data.h", root_build_dir),
    "kLicensesData",
  ]
  public_configs = [ ":gen_data_include" ]
}

# Generates version.h from git tags. Only rewrites the file when the version
# string actually changes, and GN's restat=1 on actions means Ninja skips
# recompilation when the content is unchanged. A depfile tracks .git/HEAD and
# the current branch ref so the action re-runs on commits and branch switches.
action("version") {
  script = "//build/gen_version.py"
  depfile = "$target_gen_dir/version.d"
  outputs = [ "$target_gen_dir/version.h" ]
  args = [
    rebase_path("$target_gen_dir/version.h", root_build_dir),
    rebase_path("$target_gen_dir/version.d", root_build_dir),
    rebase_path("//", root_build_dir),
  ]
  if (is_debug) {
    args += [ "--debug" ]
  }
  public_configs = [ ":gen_data_include" ]
}

action("icon_data") {
  script = "//build/gen_icon_data.py"
  sources = [ "icon.png" ]
  outputs = [ "$target_gen_dir/icon_data.h" ]
  args = [
    rebase_path("icon.png", root_build_dir),
    rebase_path("$target_gen_dir/icon_data.h", root_build_dir),
  ]
  public_configs = [ ":gen_data_include" ]
}

if (is_win) {
  action("icon_ico") {
    script = "//build/gen_icon_ico.py"
    sources = [ "icon.png" ]
    outputs = [ "$target_gen_dir/icon.ico" ]
    args = [
      rebase_path("icon.png", root_build_dir),
      rebase_path("$target_gen_dir/icon.ico", root_build_dir),
    ]
    public_configs = [ ":gen_data_include" ]
  }
}

config("gen_data_include") {
  include_dirs = [ "$target_gen_dir" ]
}

